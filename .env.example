# Client (Vite) — safe to expose, the anon key is public by design
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# Production URL used in share text (optional; falls back to window.location.origin)
VITE_SITE_URL=https://deadline.example.com

# Vercel OG image function (server-side, same values)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Supabase edge function secrets (set with: supabase secrets set IP_SALT=...)
# IP_SALT=some-long-random-string
